// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  NDRF_ADMIN
  COLLECTOR
  CITIZEN
  VOLUNTEER
  NGO
  EVACUEE
  // New roles added for action teams
  NDRF
  SDRF
  FIRE
  POLICE
  MEDICAL
  AMBULANCE
  CIVIL_DEFENSE
  RELIEF_CAMP
  SUPER_ADMIN
}

enum UserStatus {
  pending
  active
  suspended
  rejected
}

// ============================================================================
// MODELS
// ============================================================================

// Regions (Districts, Talukas, Wards)
model Region {
  id            String   @id @default(cuid())
  name          String
  type          String   // 'state', 'district', 'taluka', 'ward'
  parentId      String?
  parent        Region?  @relation("RegionHierarchy", fields: [parentId], references: [id])
  children      Region[] @relation("RegionHierarchy")
  
  // Geographic data (stored as JSON strings in SQLite)
  geometry      String?    // GeoJSON polygon (as string)
  centroid      String?    // GeoJSON point (as string)
  
  population    Int?
  areaSqKm      Float?
  
  riskScores    RiskScore[]
  disasters     Disaster[]
  infrastructure Infrastructure[]
  
  // Multi-user system relations
  userProfiles  UserProfile[]  @relation("DistrictUsers")
  incidents     Incident[]     @relation("RegionIncidents")
  volunteers    Volunteer[]    @relation("VolunteerRegion")
  tasks         Task[]         @relation("TaskRegion")
  resources     Resource[]     @relation("ResourceRegion")
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([type])
  @@index([parentId])
}

// Risk Scores (Time-series data)
model RiskScore {
  id                String   @id @default(cuid())
  regionId          String
  region            Region   @relation(fields: [regionId], references: [id])
  
  timestamp         DateTime @default(now())
  riskScore         Float    // 0-100
  primaryHazard     String   // 'flood', 'drought', 'earthquake', 'heatwave'
  
  // Contributing factors (stored as JSON string in SQLite)
  factors           String?    // { "heavy_rainfall": 0.8, "saturated_soil": 0.6 }
  
  modelVersion      String?
  confidence        Float?   // 0-1
  
  @@index([regionId, timestamp])
  @@index([timestamp])
}

// Historical Disasters
model Disaster {
  id              String   @id @default(cuid())
  type            String   // 'flood', 'drought', 'earthquake', etc.
  name            String?  // e.g., "July 2019 Pune Floods"
  
  startDate       DateTime
  endDate         DateTime?
  
  regionId        String
  region          Region   @relation(fields: [regionId], references: [id])
  
  severity        String   // 'minor', 'moderate', 'severe', 'catastrophic'
  casualties      Int?
  economicLossCr  Float?   // in Crores
  
  description     String?
  source          String?  // 'NDMA', 'PMC', 'News'
  
  createdAt       DateTime @default(now())
  
  @@index([regionId])
  @@index([startDate])
}

// Infrastructure (Buildings, Bridges, etc.)
model Infrastructure {
  id                  String   @id @default(cuid())
  name                String
  type                String   // 'bridge', 'hospital', 'school', 'dam'
  
  regionId            String
  region              Region   @relation(fields: [regionId], references: [id])
  
  location            String     // GeoJSON point { lat, lng } as string
  
  constructionYear    Int?
  vulnerabilityScore  Float?   // 0-100
  lastAssessmentDate  DateTime?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([regionId])
  @@index([type])
}

// Alert History
model Alert {
  id          String   @id @default(cuid())
  regionIds   String   // Comma-separated region IDs
  
  severity    String   // 'watch', 'advisory', 'warning', 'critical'
  type        String   // 'flood', 'drought', etc.
  
  message     String
  language    String   @default("en") // 'en', 'mr', 'hi'
  
  channels    String   // Comma-separated: 'sms,push,email'
  recipients  Int?     // Number of people notified
  
  sentAt      DateTime @default(now())
  expiresAt   DateTime?
  
  @@index([sentAt])
}

// Weather Data (from IMD)
model WeatherData {
  id            String   @id @default(cuid())
  stationId     String
  stationName   String?
  
  timestamp     DateTime
  
  temperature   Float?   // Celsius
  humidity      Float?   // Percentage
  rainfallMm    Float?
  windSpeedKmh  Float?
  pressure      Float?   // hPa
  
  // Store raw IMD response for reference (as JSON string)
  rawData       String?
  
  createdAt     DateTime @default(now())
  
  @@index([stationId, timestamp])
  @@index([timestamp])
}

// ==================== MULTI-USER SYSTEM ====================

enum VolunteerStatus {
  PENDING         // Registration submitted
  VERIFIED        // Ward office verified
  ACTIVE          // Available for deployment
  ON_DUTY         // Currently deployed
  INACTIVE        // Not available
  SUSPENDED       // Suspended by authority
}

enum IncidentStatus {
  REPORTED        // Just reported by citizen
  VERIFIED        // Verified by authority
  ASSIGNED        // Team assigned
  IN_PROGRESS     // Team on site
  RESOLVED        // Incident resolved
  CLOSED          // Closed by authority
}

enum TaskStatus {
  PENDING         // Task created
  ASSIGNED        // Assigned to volunteer
  ACCEPTED        // Volunteer accepted
  IN_PROGRESS     // Volunteer checked in
  COMPLETED       // Task completed
  VERIFIED        // Verified by authority
}

// User accounts with role-based access
model User {
  id                String      @id @default(cuid())
  email             String      @unique
  phone             String?     @unique
  passwordHash      String      // Original column (required)
  password_hash     String?     @map("password_hash") // New auth column (nullable for citizens)

  
role              UserRole    // CITIZEN, VOLUNTEER, NDRF, etc.
  name              String      // Original column name
  isActive          Boolean     @default(true) // Original column
  status            UserStatus? // New column (nullable for compatibility)
  
  lastLogin         DateTime?   // Original column
  createdAt         DateTime    @default(now()) // Original column
  updatedAt         DateTime    @updatedAt // Original column
  
  // OTP verification (for citizens) - NEW COLUMNS ADDED
  otpCode           String?     @map("otp_code")
  otpExpiresAt      DateTime?   @map("otp_expires_at")
  otpAttempts       Int         @default(0) @map("otp_attempts")
  otpLastSentAt     DateTime?   @map("otp_last_sent_at")
  
  // Validation (for action teams)
  validatedBy       String?     @map("validated_by")
  validatedAt       DateTime?   @map("validated_at")
  
  // Relationships
  profile           UserProfile?
  teamProfile       TeamProfile?
  sessions          Session[]
  incidentsReported Incident[]  @relation("ReportedBy")
  incidentsAssigned Incident[]  @relation("AssignedTo")
  volunteerProfile  Volunteer?
  ngoProfile        NGO?
  validationQueue   ValidationQueue[]  @relation("ValidationUser")
  validatedUsers    ValidationQueue[]  @relation("ValidationReviewer")
  auditLogs         AuditLog[]
  
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([otpExpiresAt])
  @@map("User")
}

// Extended user profiles
model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  districtId      String?  // For Collectors and field officers
  district        Region?  @relation("DistrictUsers", fields: [districtId], references: [id])
  
  organization    String?  // NDRF battalion, NGO name
  designation     String?  // Collector, Commandant, etc.
  
  address         String?
  emergencyContact String?
  
  // Evacuee-specific fields
  reliefCampId    String?  // Relief camp location ID
  evacuatedFrom   String?  // Original address before evacuation
  evacuationDate  DateTime?
  familyMembers   Int?     // Number of family members
  medicalNeeds    String?  // Medical conditions or requirements
  aadhaarNumber   String?  // For identity verification
  
  // Permissions (stored as JSON string)
  permissions     String?  // ["view_incidents", "assign_teams", "export_data"]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([districtId])
}

// Authentication sessions
model Session {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Token Details
  tokenHash       String   @unique @map("token_hash") // SHA-256 hash of JWT token
  expiresAt       DateTime @map("expires_at")
  
  // Device & Security
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  
  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  lastActivity    DateTime @default(now()) @map("last_activity")
  
  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("Session")
}

// Incidents reported by citizens or detected by system
model Incident {
  id              String          @id @default(cuid())
  type            String          // 'flood', 'building_collapse', 'fire', 'medical_emergency'
  title           String
  description     String
  
  status          String          @default("REPORTED") // REPORTED, VERIFIED, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED
  severity        String          // 'low', 'medium', 'high', 'critical'
  
  location        String          // GeoJSON point { lat, lng }
  address         String?
  regionId        String?
  region          Region?         @relation("RegionIncidents", fields: [regionId], references: [id])
  
  reportedById    String
  reportedBy      User            @relation("ReportedBy", fields: [reportedById], references: [id])
  
  assignedToId    String?
  assignedTo      User?           @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  // Photos uploaded by citizen (stored as JSON array of URLs)
  photos          String?         // ["url1", "url2"]
  
  peopleAffected  Int?
  resourcesNeeded String?         // "medical_kit:5,food_packets:100"
  
  resolvedAt      DateTime?
  closedAt        DateTime?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([status])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([createdAt])
}

// Volunteer profiles
model Volunteer {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status          String          @default("PENDING") // PENDING, VERIFIED, ACTIVE, ON_DUTY, INACTIVE, SUSPENDED
  
  // Skills (stored as JSON array)
  skills          String          // ["first_aid", "swimming", "driving"]
  
  // Verification
  verifiedBy      String?         // Ward office name
  verifiedAt      DateTime?
  idProofUrl      String?         // Uploaded ID document
  
  // Location preferences
  preferredRegionId String?
  preferredRegion   Region?       @relation("VolunteerRegion", fields: [preferredRegionId], references: [id])
  
  // Availability
  isAvailable     Boolean         @default(true)
  currentLocation String?         // GeoJSON point for geofencing
  
  // Statistics
  tasksCompleted  Int             @default(0)
  hoursServed     Float           @default(0)
  rating          Float?          // 0-5 stars
  
  tasks           Task[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([status])
  @@index([isAvailable])
  @@index([preferredRegionId])
}

// Tasks for volunteers
model Task {
  id              String      @id @default(cuid())
  title           String
  description     String
  
  status          String      @default("PENDING") // PENDING, ASSIGNED, ACCEPTED, IN_PROGRESS, COMPLETED, VERIFIED
  type            String      // 'rescue', 'relief_distribution', 'medical_assistance'
  
  location        String      // GeoJSON point
  regionId        String?
  region          Region?     @relation("TaskRegion", fields: [regionId], references: [id])
  
  assignedToId    String?
  assignedTo      Volunteer?  @relation(fields: [assignedToId], references: [id])
  
  requiredSkills  String?     // ["first_aid", "swimming"]
  priority        String      // 'low', 'medium', 'high', 'urgent'
  
  estimatedHours  Float?
  
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  verifiedAt      DateTime?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([status])
  @@index([assignedToId])
  @@index([regionId])
}

// NGO profiles  
model NGO {
  id              String      @id @default(cuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  organizationName String
  registrationNo  String?     // 80G/12A registration
  contactPerson   String
  
  // Capabilities
  resourceTypes   String      // ["food", "medical_supplies", "shelter"]
  serviceAreas    String      // ["Maharashtra", "Pune"]
  
  // Verification
  isVerified      Boolean     @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  
  resources       Resource[]
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([isVerified])
}

// Resources contributed by NGOs
model Resource {
  id              String      @id @default(cuid())
  ngoId           String
  ngo             NGO         @relation(fields: [ngoId], references: [id])
  
  type            String      // 'food', 'medical', 'shelter', 'vehicle'
  name            String
  quantity        Int
  unit            String      // 'packets', 'liters', 'units'
  
  location        String      // GeoJSON point where resource is available
  regionId        String?
  region          Region?     @relation("ResourceRegion", fields: [regionId], references: [id])
  
  status          String      // 'available', 'allocated', 'delivered'
  allocatedTo     String?     // Incident ID or relief camp ID
  
  expiresAt       DateTime?   // For perishable items
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  @@index([ngoId])
  @@index([status])
  @@index([regionId])
}

// SOS Alerts sent to volunteers
model SosAlert {
  id                String      @id @default(cuid())
  
  // Incident details
  incidentId        String      // Reference to the disaster/incident
  disasterType      String      // 'flood', 'fire', 'building_collapse', etc.
  title             String
  description       String
  severity          String      // 'low', 'medium', 'high', 'critical'
  
  // Location details
  location          String      // GeoJSON point { lat, lng }
  address           String
  
  // Complainant/Reporter details
  reporterName      String
  reporterPhone     String
  
  // Required skills for this disaster
  requiredSkills    String      // JSON array: ["diver", "swimmer", "boat_operator"]
  
  // Alert metadata
  sentBy            String      // Admin user ID who triggered the SOS
  sentAt            DateTime    @default(now())
  
  // Volunteers notified (stored as JSON array of volunteer IDs)
  volunteersNotified String     // ["vol-id-1", "vol-id-2", "vol-id-3"]
  totalVolunteersNotified Int   @default(0)
  
  // Response tracking
  volunteersResponded  String?  // JSON array of volunteer IDs who responded
  totalVolunteersResponded Int  @default(0)
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([incidentId])
  @@index([sentAt])
  @@index([disasterType])
}

// ============================================================================
// AUTHENTICATION MODELS - Added for comprehensive auth system
// ============================================================================

// Team Profile - Extended details for action teams (NDRF, SDRF, Fire, Police, etc.)
model TeamProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique @map("user_id")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Team Details
  teamType                String    @map("team_type") // ndrf sdrf, fire, police, medical, ambulance, civil_defense
  teamId                  String?   @map("team_id") // Official team ID (e.g., NDRF-MH-01)
  badgeNumber             String?   @map("badge_number") // Officer badge number
  department              String?   // Department name
  district                String?   // Operating district
  state                   String    @default("Maharashtra")
  
  // Skills & Verification
  specializations         String[]  // JSON array: ["flood_rescue", "medical_first_aid", "search_rescue"]
  verificationDocumentUrl String?   @map("verification_document_url") // Uploaded ID proof / badge scan URL
  
  // Duty Status
  onDuty                  Boolean   @default(false) @map("on_duty")
  lastDutyToggle          DateTime? @map("last_duty_toggle")
  
  // Timestamps
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  
  @@index([userId])
  @@index([teamType])
  @@index([district])
  @@index([onDuty])
  @@map("team_profiles")
}

// Validation Queue - NDRF admin review queue for action team registrations
model ValidationQueue {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  user              User      @relation("ValidationUser", fields: [userId], references: [id], onDelete: Cascade)
  
  // Request Details
  requestedRole     String    @map("requested_role") // Role they want to register as
  status            String    @default("pending") // pending, approved, rejected
  documents         Json?     // Uploaded documents: {id_proof: url, badge: url, dept_letter: url}
  notes             String?   // Applicant's notes/justification
  
  // Review Details
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  reviewedBy        String?   @map("reviewed_by")
  reviewer          User?     @relation("ValidationReviewer", fields: [reviewedBy], references: [id])
  reviewedAt        DateTime? @map("reviewed_at")
  rejectionReason   String?   @map("rejection_reason") // Reason for rejection
  
  @@index([status])
  @@index([userId])
  @@index([submittedAt])
  @@map("validation_queue")
}

// Audit Log - Security tracking for sensitive actions
model AuditLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // Action Details
  action        String   // LOGIN, LOGOUT, REGISTER, VALIDATE_USER, UPDATE_STATUS, etc.
  entityType    String?  @map("entity_type") // user, team_profile, incident, resource
  entityId      String?  @map("entity_id") // ID of affected entity
  details       Json?    // Additional context: {old_value, new_value, reason}
  
  // Security Context
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  
  // Timestamp
  createdAt     DateTime @default(now()) @map("created_at")
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

